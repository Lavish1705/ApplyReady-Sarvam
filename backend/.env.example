# ApplyReady AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.

PORT=5000
ML_SERVICE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500,null
MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=

# ── Sarvam AI Official API ───────────────────────────────────────────────────
